                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "if (pm.response.code === 201) {",
                  "  const b = pm.response.json();",
                  "  b.titulos.forEach(t => console.log(b.tramite + ' ' + t.anio + ': título ' + t.id_titulo + ', número ' + t.numero_titulo + ', valor ' + t.valor));",
                  "  console.log('Total: ' + b.total);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
